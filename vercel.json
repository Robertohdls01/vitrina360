{
  "rewrites": [
    {
      "source": "/t/:slug",
      "destination": "/app.html"
    },
    {
      "source": "/panel",
      "destination": "/app.html"
    },
    {
      "source": "/censo",
      "destination": "/censo.html"
    },
    {
      "source": "/shopcut",
      "destination": "/shopcut.html"
    },
    {
      "source": "/menu",
      "destination": "/menu.html"
    }
  ],
  "functions": {
    "api/ia.js": {
      "maxDuration": 60
    },
    "api/probador.js": {
      "maxDuration": 60
    },
    "api/menu.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/sincronizar",
      "schedule": "0 12 * * *"
    }
  ]
}