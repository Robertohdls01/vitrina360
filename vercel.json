{
  "rewrites": [
    {
      "source": "/diario",
      "destination": "/diario.html"
    },
    {
      "source": "/r/:slug",
      "destination": "/revista.html"
    },
    {
      "source": "/familia",
      "destination": "/familia.html"
    },
    {
      "source": "/vida/:code",
      "destination": "/vida.html"
    },
    {
      "source": "/vida",
      "destination": "/vida.html"
    },
    {
      "source": "/fiesta-autos",
      "destination": "/fiesta-autos.html"
    },
    {
      "source": "/fiesta-personal",
      "destination": "/fiesta-personal.html"
    },
    {
      "source": "/fiesta/:code",
      "destination": "/fiesta.html"
    },
    {
      "source": "/fiesta-panel",
      "destination": "/fiesta-panel.html"
    },
    {
      "source": "/fiestas",
      "destination": "/fiesta-panel.html"
    },
    {
      "source": "/galeria/:code",
      "destination": "/galeria.html"
    },
    {
      "source": "/t/:slug",
      "destination": "/app.html"
    },
    {
      "source": "/panel",
      "destination": "/app.html"
    },
    {
      "source": "/shoprevista",
      "destination": "/app.html"
    },
    {
      "source": "/censo",
      "destination": "/censo.html"
    },
    {
      "source": "/shopcut",
      "destination": "/shopcut.html"
    },
    {
      "source": "/menu",
      "destination": "/menu.html"
    },
    {
      "source": "/shopmenu",
      "destination": "/shopmenu.html"
    },
    {
      "source": "/folleto",
      "destination": "/folleto.html"
    },
    {
      "source": "/parques",
      "destination": "/parques.html"
    },
    {
      "source": "/provideo",
      "destination": "/provideo.html"
    },
    {
      "source": "/firmar",
      "destination": "/firmar.html"
    },
    {
      "source": "/vender",
      "destination": "/vender.html"
    },
    {
      "source": "/vendedor",
      "destination": "/vendedor.html"
    }
  ],
  "functions": {
    "api/ia.js": {
      "maxDuration": 60
    },
    "api/probador.js": {
      "maxDuration": 60
    },
    "api/menu.js": {
      "maxDuration": 60
    },
    "api/guia.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/sincronizar",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/fiesta?accion=programados",
      "schedule": "0 22 * * *"
    }
  ],
  "headers": [
    {
      "source": "/ml-fotos/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/muestra",
      "destination": "/menu?m=demopublico&e=demo&caja=1",
      "permanent": false
    },
    {
      "source": "/muestra-mesa",
      "destination": "/menu?m=demopublico&mesa=1",
      "permanent": false
    },
    {
      "source": "/guia",
      "destination": "/guia.html",
      "permanent": false
    },
    {
      "source": "/mundial",
      "destination": "/mundial.html",
      "permanent": false
    },
    {
      "source": "/probar-menu",
      "destination": "/probar-menu.html",
      "permanent": false
    },
    {
      "source": "/qr-muestra",
      "destination": "/qr-muestra.html",
      "permanent": false
    },
    {
      "source": "/cartel-muestra",
      "destination": "/menu?m=demopublico&cartel=1",
      "permanent": false
    },
    {
      "source": "/qr-productos",
      "destination": "/qr-productos.html",
      "permanent": false
    },
    {
      "source": "/nuevo",
      "destination": "/menu",
      "permanent": false
    }
  ]
}